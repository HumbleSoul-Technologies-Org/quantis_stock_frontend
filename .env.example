# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.com/api
NEXT_PUBLIC_CURRENCY_API_BASE=https://open.er-api.com/v6

# Vercel Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# Rate Limiting (optional)
NEXT_PUBLIC_VITE_API_THRESHOLD=60
NEXT_PUBLIC_VITE_THROTTLE_WINDOW=60000

# Maintenance Mode
# Set to "maintenance" to enable maintenance mode
MODE=maintenance

# Email Configuration (for maintenance notifications)
# Default email provider is Resend for reliable email delivery
EMAIL_PROVIDER=resend  # Options: sendgrid, resend, console

# Resend API Key Configuration
# 1. Sign up for a Resend account at https://resend.com
# 2. Go to your dashboard and create an API key
# 3. Copy the API key and paste it here
EMAIL_API_KEY=your_resend_api_key

# Email From Configuration
# IMPORTANT: Domain Verification Required
# Before sending emails, you must verify your domain with Resend:
# 1. In your Resend dashboard, go to Domains
# 2. Add your domain (e.g., stockos.com)
# 3. Follow the DNS verification steps to add the required TXT and CNAME records
# 4. Wait for verification to complete (can take up to 24 hours)
# 5. Set EMAIL_FROM to an email address using your verified domain
EMAIL_FROM=noreply@your-verified-domain.com
EMAIL_FROM_NAME=StockOS

# Maintenance API Key (for sending notifications)
MAINTENANCE_API_KEY=your_secure_api_key

# App URL (for email links)
NEXT_PUBLIC_APP_URL=https://yourapp.com

 
